#compdef wf

_wf_sessions() {
  local -a sessions

  sessions=("${(@f)$(tmux list-sessions -F '#S' 2>/dev/null)}")

  if (( ${#sessions} )); then
    _describe -t sessions 'tmux session' sessions
  else
    _message 'no active tmux sessions'
  fi
}

_arguments -C \
  '(-h --help)'{-h,--help}'[display help]' \
  '-git[show git repository statuses in the current directory]' \
  '-p[create or enter a workspace at a directory]:directory:_directories' \
  '-d[delete a tmux session]:session:_wf_sessions' \
  '-x[detach from the current tmux session]' \
  '-n[create windows in the current directory (default 1)]::window count (0-5):(0 1 2 3 4 5)' \
  '-N[create windows in the workspace starting directory (default 1)]::window count (0-5):(0 1 2 3 4 5)' \
  '-cw[close the current window unless it is the last window]' \
  '-s[split the current pane into left and right panes]' \
  '-S[split the current pane into top and bottom panes]' \
  '-max[toggle pane zoom and restore the previous layout]' \
  '-m[alias for -max]' \
  '-r[resize the current pane]:width change (-100..100) or absolute width (1%..100%): :height change (-100..100) or absolute height (1%..100%): ' \
  '-rq[reset exactly four panes to an equal 2x2 grid]' \
  '-rd[reset exactly two panes to equal sizes, preserving orientation]' \
  '-rt[reset exactly three panes to a half-width left pane and stacked right panes]' \
  '-r2[alias for -rd]' \
  '-r3[alias for -rt]' \
  '-r4[alias for -rq]' \
  '-quad[split a single-pane window into a numbered 2x2 grid]' \
  '-q[alias for -quad]' \
  '-tri[create a full-height left pane and two stacked right panes]' \
  '-t[alias for -tri]' \
  '-cs[close the focused pane unless it is the last pane]' \
  '-cas[close all other panes in the current window]' \
  '-caw[close all other windows in the current workspace]' \
  '-label[rename the current tmux window]:window name:' \
  '-l[alias for -label]:window name:' \
  '-nolabel[remove the custom label and resume automatic window naming]' \
  '-nl[alias for -nolabel]' \
  '1:session:_wf_sessions'
