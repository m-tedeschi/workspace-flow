#!/usr/bin/env zsh

# wf - Workspace Flow
# A lightweight tmux workspace manager

session_exists() {
  tmux has-session -t "=$1" 2>/dev/null
}

list_sessions() {
  local sessions
  local session_name display_name created_epoch created_date created_time window_count attached_status

  if ! sessions="$(tmux list-sessions -F '#S	#{session_created}	#{session_windows}	#{?session_attached,attached,}' 2>/dev/null)"; then
    echo "wf: no active sessions"
    return
  fi

  zmodload zsh/datetime

  printf "%-24s %-8s %-8s %7s  %s\n" "SESSION" "DATE" "TIME" "WINDOWS" "STATUS"
  print -r -- "$sessions" | sort -f | while IFS=$'\t' read -r session_name created_epoch window_count attached_status; do
    if (( ${#session_name} > 24 )); then
      display_name="${session_name[1,21]}..."
    else
      display_name="$session_name"
    fi

    created_date="$(strftime "%m-%d-%y" "$created_epoch")"
    created_time="$(strftime "%H:%M" "$created_epoch")"
    printf "%-24s %-8s %-8s %7s  %s\n" "$display_name" "$created_date" "$created_time" "$window_count" "$attached_status"
  done
}

list_repo_statuses() {
  local directory directory_name display_name branch repo_status found_repo

  found_repo=0

  for directory in ./*(/N); do
    if ! git -C "$directory" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      continue
    fi

    if (( found_repo == 0 )); then
      printf "%-24s %-24s %s\n" "DIRECTORY" "BRANCH" "STATUS"
      found_repo=1
    fi

    directory_name="${directory:t}"
    if (( ${#directory_name} > 24 )); then
      display_name="${directory_name[1,21]}..."
    else
      display_name="$directory_name"
    fi

    branch="$(git -C "$directory" branch --show-current 2>/dev/null)"
    if [[ -z "$branch" ]]; then
      branch="detached:$(git -C "$directory" rev-parse --short HEAD 2>/dev/null)"
    fi

    if [[ -n "$(git -C "$directory" status --porcelain 2>/dev/null)" ]]; then
      repo_status="uncommitted changes"
    else
      repo_status="up to date"
    fi

    printf "%-24s %-24s %s\n" "$display_name" "$branch" "$repo_status"
  done

  if (( found_repo == 0 )); then
    echo "wf: no git repositories found"
  fi
}

switch_or_attach() {
  local session_name="$1"

  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "=$session_name"
  else
    tmux attach-session -t "=$session_name"
  fi
}

create_default_session() {
  create_default_session_in_directory "$1" "$PWD"
}

create_default_session_in_directory() {
  local session_name="$1"
  local directory="$2"

  tmux new-session -d -s "$session_name" -c "$directory" &&
    tmux set-option -t "=$session_name" @wf_directory "$directory"
}

is_valid_session_name() {
  local session_name="$1"

  [[ -n "$session_name" ]] &&
    [[ "$session_name" != "." ]] &&
    [[ "$session_name" != ".." ]] &&
    [[ "$session_name" =~ '^[A-Za-z0-9_-]+$' ]] &&
    has_alphanumeric "$session_name"
}

has_alphanumeric() {
  local session_name="$1"

  [[ "$session_name" =~ '[A-Za-z0-9]' ]]
}

session_name_from_directory_name() {
  local directory_name="$1"
  local session_name="${directory_name//[^A-Za-z0-9_-]/_}"

  if is_valid_session_name "$session_name"; then
    echo "$session_name"
    return 0
  fi

  return 1
}

session_name_from_current_directory() {
  session_name_from_directory_name "${PWD:t}"
}

session_name_from_home_directory() {
  session_name_from_directory_name "${HOME:t}"
}

print_invalid_session_name() {
  local session_name="$1"

  echo "wf: invalid session name '$session_name'" >&2
  echo "wf: session names may only contain letters, numbers, '_', and '-'" >&2
  echo "wf: session names must contain at least one letter or number" >&2
  echo "wf: session names may not be '.' or '..'" >&2
}

create_session_from_current_directory() {
  local directory_name="${PWD:t}"
  local session_name

  if ! session_name="$(session_name_from_current_directory)"; then
    echo "wf: could not derive a safe session name from '$directory_name'" >&2
    echo "wf: directory names must contain at least one letter or number" >&2
    return 1
  fi

  if session_exists "$session_name"; then
    echo "wf: session already exists" >&2
    return 1
  fi

  if ! create_default_session "$session_name"; then
    echo "wf: failed to create session '$session_name'" >&2
    return 1
  fi

  switch_or_attach "$session_name"
}

create_or_enter_home_session() {
  local directory_name="${HOME:t}"
  local session_name

  if ! session_name="$(session_name_from_home_directory)"; then
    echo "wf: could not derive a safe session name from '$directory_name'" >&2
    echo "wf: home directory name must contain at least one letter or number" >&2
    return 1
  fi

  if ! session_exists "$session_name"; then
    if ! create_default_session_in_directory "$session_name" "$HOME"; then
      echo "wf: failed to create session '$session_name'" >&2
      return 1
    fi
  fi

  switch_or_attach "$session_name"
}

delete_session() {
  local session_name="$1"
  local prompt="$2"

  printf "%s" "$prompt"
  read -r -k 1 REPLY
  echo

  if [[ "$REPLY" == [yY] ]]; then
    tmux kill-session -t "=$session_name"
    echo "wf: deleted session '$session_name'"
  else
    echo "wf: delete cancelled"
  fi
}

delete_current_session() {
  local session_name

  if [[ -z "$TMUX" ]]; then
    echo "wf: -d requires a session name outside tmux" >&2
    return 1
  fi

  if ! session_name="$(tmux display-message -p '#S')"; then
    echo "wf: could not determine current session" >&2
    return 1
  fi

  delete_session "$session_name" "wf: delete current session '$session_name'? [y/N] "
}

detach_current_client() {
  if [[ -z "$TMUX" ]]; then
    echo "wf: -x must be run inside a tmux session" >&2
    return 1
  fi

  tmux detach-client
}

split_current_pane() {
  local command="$1"
  local direction="-h"

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  if [[ "$command" == "-hs" ]]; then
    direction="-v"
  fi

  tmux split-window "$direction" -c '#{pane_current_path}'
}

close_current_pane() {
  local pane_count

  if [[ -z "$TMUX" ]]; then
    echo "wf: -cs must be run inside a tmux session" >&2
    return 1
  fi

  if ! pane_count="$(tmux display-message -p '#{window_panes}')"; then
    echo "wf: could not determine pane count" >&2
    return 1
  fi

  if [[ "$pane_count" != <-> ]]; then
    echo "wf: could not determine pane count" >&2
    return 1
  fi

  if (( pane_count <= 1 )); then
    echo "wf: cannot close the last pane in a window" >&2
    return 1
  fi

  tmux kill-pane
}

create_window() {
  local command="$1"
  local directory="$PWD"

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  if [[ "$command" == "-C" ]]; then
    if ! directory="$(tmux display-message -p '#{?@wf_directory,#{@wf_directory},#{session_path}}')"; then
      echo "wf: could not determine workspace directory" >&2
      return 1
    fi
  fi

  if [[ -z "$directory" || ! -d "$directory" ]]; then
    echo "wf: window directory does not exist: '$directory'" >&2
    return 1
  fi

  tmux new-window -c "$directory"
}

close_current_window() {
  local window_count

  if [[ -z "$TMUX" ]]; then
    echo "wf: -cw must be run inside a tmux session" >&2
    return 1
  fi

  if ! window_count="$(tmux display-message -p '#{session_windows}')"; then
    echo "wf: could not determine window count" >&2
    return 1
  fi

  if [[ "$window_count" != <-> ]]; then
    echo "wf: could not determine window count" >&2
    return 1
  fi

  if (( window_count <= 1 )); then
    echo "wf: cannot close the last window in a session; use 'wf -d' to delete the workspace" >&2
    return 1
  fi

  tmux kill-window
}

show_help() {
  cat <<'EOF'
  wf - Workspace Flow. A lightweight tmux workspace manager

Commands:
  wf
      List active tmux sessions.

  wf <session_name>
      Switch or attach to the session if it exists.
      Otherwise, create it with one window.

  wf .
      Create a session named after the current directory.

  wf ~
      Create a session named after the home directory.
      New windows start in the home directory.

  wf -d
      Prompt for confirmation, then delete the current session.
      Only works from inside tmux.

  wf -d <session_name>
      Prompt for confirmation, then delete the session.

  wf -x
      Detach from the current tmux session.
      Only works from inside tmux.

  wf -c
      Create and focus a window in the invoking shell's current directory.
      Only works from inside tmux.

  wf -C
      Create and focus a window in the workspace's starting directory.
      Only works from inside tmux.

  wf -cw
      Close the current window and all its panes, terminating their programs.
      Refuse to close the last window in a session.
      Only works from inside tmux.

  wf -s
      Split the current pane into left and right panes.
      Focus the new pane, starting in the current pane's directory.
      Only works from inside tmux.

  wf -hs
      Split the current pane into top and bottom panes.
      Focus the new pane, starting in the current pane's directory.
      Only works from inside tmux.

  wf -cs
      Close the focused pane, terminating programs running inside it.
      Refuse to close the last pane in a window.
      Only works from inside tmux.

  wf -label <window_name>
      Rename the current tmux window.
      Only works from inside tmux.

  wf -status
      Show branch and working tree status for git repositories in the
      current directory.

  wf --help
      Display this help message.
EOF
}

main() {
  local command="$1"

  case "$command" in
    "")
      list_sessions
      ;;

    --help|-h)
      show_help
      ;;

    -status)
      if (( $# != 1 )); then
        echo "Usage: wf -status" >&2
        return 1
      fi

      list_repo_statuses
      ;;

    -label)
      shift
      local window_label="$*"

      if [[ -z "$TMUX" ]]; then
        echo "wf: -label must be run inside a tmux session" >&2
        return 1
      fi

      if [[ -z "$window_label" ]]; then
        echo "Usage: wf -label <window_name>" >&2
        return 1
      fi

      tmux rename-window "$window_label"
      ;;

    -d)
      local session_name="$2"

      if (( $# == 1 )); then
        delete_current_session
        return
      fi

      if (( $# != 2 )); then
        echo "Usage: wf -d [session_name]" >&2
        return 1
      fi

      if ! is_valid_session_name "$session_name"; then
        print_invalid_session_name "$session_name"
        return 1
      fi

      if ! session_exists "$session_name"; then
        echo "wf: session '$session_name' does not exist" >&2
        return 1
      fi

      delete_session "$session_name" "wf: delete '$session_name'? [y/N] "
      ;;

    -c|-C|-cw)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      if [[ "$command" == "-cw" ]]; then
        close_current_window
      else
        create_window "$command"
      fi
      ;;

    -s|-hs|-cs)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      if [[ "$command" == "-cs" ]]; then
        close_current_pane
      else
        split_current_pane "$command"
      fi
      ;;

    -x)
      if (( $# != 1 )); then
        echo "Usage: wf -x" >&2
        return 1
      fi

      detach_current_client
      ;;

    -*)
      echo "wf: unknown option '$command'" >&2
      echo "wf: run 'wf --help' for usage" >&2
      return 1
      ;;

    *)
      if (( $# != 1 )); then
        echo "Usage: wf <session_name>" >&2
        return 1
      fi

      if [[ "$command" == "." ]]; then
        create_session_from_current_directory
        return
      fi

      if [[ "$command" == "~" || "$command" == "$HOME" ]]; then
        create_or_enter_home_session
        return
      fi

      local session_name="$command"

      if ! is_valid_session_name "$session_name"; then
        print_invalid_session_name "$session_name"
        return 1
      fi

      if ! session_exists "$session_name"; then
        if ! create_default_session "$session_name"; then
          echo "wf: failed to create session '$session_name'" >&2
          return 1
        fi
      fi

      switch_or_attach "$session_name"
      ;;
  esac
}

main "$@"
