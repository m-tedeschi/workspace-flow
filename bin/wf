#!/usr/bin/env zsh

# wf - Workspace Flow
# A lightweight tmux workspace manager

save_layout() {
  local name="$1"
  local layout_dir="${XDG_CONFIG_HOME:-$HOME/.config}/wf/layouts"
  local layout_file="$layout_dir/$name.layout"
  local info pane_count layout extra
  local -a target_args

  if [[ -z "$TMUX" ]]; then
    echo "wf: -save-layout must be run inside a tmux session" >&2
    return 1
  fi
  if ! is_valid_session_name "$name"; then
    echo "wf: invalid layout name '$name'; use letters, numbers, '_' or '-', with at least one letter or number" >&2
    return 1
  fi
  if [[ -e "$layout_file" || -L "$layout_file" ]]; then
    echo "wf: layout '$name' already exists; choose a different name" >&2
    return 1
  fi

  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi
  if ! info="$(tmux display-message -p "${target_args[@]}" $'#{window_panes}\t#{window_layout}')"; then
    echo "wf: could not read current window layout" >&2
    return 1
  fi
  IFS=$'\t' read -r pane_count layout extra <<< "$info"
  if [[ "$pane_count" != <-> || -z "$layout" || -n "$extra" ]] || (( pane_count < 1 )); then
    echo "wf: could not read current window layout" >&2
    return 1
  fi

  if ! mkdir -p "$layout_dir"; then
    echo "wf: could not create layout directory '$layout_dir'" >&2
    return 1
  fi
  if ! (setopt noclobber; printf 'version=1\npanes=%s\nlayout=%s\n' "$pane_count" "$layout" > "$layout_file"); then
    echo "wf: could not save layout '$name'" >&2
    return 1
  fi

  echo "wf: saved layout '$name' ($pane_count panes) to $layout_file"
}

# Populate the caller's layout_count, layout_geometry, and layout_commands.
# Saved files are data: only command values are executed, and only when loading.
read_saved_layout() {
  local name="$1"
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/wf/layouts/$name.layout"
  local line key value slot lines=0 version=''

  if ! is_valid_session_name "$name"; then
    echo "wf: invalid layout name '$name'" >&2
    return 1
  fi
  if [[ ! -f "$file" || ! -r "$file" ]]; then
    echo "wf: saved layout '$name' not found or unreadable" >&2
    return 1
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    (( lines += 1 ))
    if (( lines <= 3 )); then
      case "$lines:$line" in
        1:version=*) version="${line#version=}" ;;
        2:panes=*) layout_count="${line#panes=}" ;;
        3:layout=*) layout_geometry="${line#layout=}" ;;
        *) echo "wf: invalid saved layout '$name'" >&2; return 1 ;;
      esac
    elif [[ -n "$line" ]]; then
      key="${line%%=*}"
      value="${line#*=}"
      slot="${key#command.}"
      if [[ "$key" != command.* || "$line" != *=* || ! "$slot" =~ '^[1-9][0-9]{0,8}$' ||
            -z "${value//[[:space:]]/}" || "$value" == *$'\r'* ]]; then
        echo "wf: invalid command entry in layout '$name'" >&2
        return 1
      fi
      layout_commands[$slot]="$value"
    fi
  done < "$file"
  if [[ "$version" != 1 || ! "$layout_count" =~ '^[1-9][0-9]{0,8}$' || -z "$layout_geometry" ]] || (( lines < 3 )); then
    echo "wf: invalid saved layout '$name'" >&2
    return 1
  fi
  for slot in "${(@k)layout_commands}"; do
    if (( slot < 2 || slot > layout_count )); then
      echo "wf: command pane must be between 2 and $layout_count in layout '$name'; pane 1 is preserved" >&2
      return 1
    fi
  done
}

set_layout_command() {
  local name="$1" slot="$2" command="$3"
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/wf/layouts/$name.layout"
  local layout_count='' layout_geometry='' temporary key
  local -A layout_commands

  read_saved_layout "$name" || return 1
  if [[ ! "$slot" =~ '^[1-9][0-9]{0,8}$' ]] || (( slot < 2 || slot > layout_count )); then
    echo "wf: command pane must be between 2 and $layout_count; pane 1 is preserved" >&2
    return 1
  fi
  if [[ "$command" == --remove ]]; then
    if (( ! ${+layout_commands[$slot]} )); then
      echo "wf: no command set for pane $slot in layout '$name'"
      return 0
    fi
    unset "layout_commands[$slot]"
  else
    if [[ -z "${command//[[:space:]]/}" || "$command" == *$'\n'* || "$command" == *$'\r'* ]]; then
      echo 'wf: layout command must be nonempty and on one line' >&2
      return 1
    fi
    layout_commands[$slot]="$command"
  fi
  temporary="$(mktemp "$file.tmp.XXXXXX")" || return 1
  if ! {
    printf 'version=1\npanes=%s\nlayout=%s\n' "$layout_count" "$layout_geometry"
    for key in ${(onk)layout_commands}; do
      print -r -- "command.$key=${layout_commands[$key]}"
    done
  } > "$temporary" || ! mv -f -- "$temporary" "$file"; then
    rm -f -- "$temporary"
    echo "wf: could not update command in layout '$name'" >&2
    return 1
  fi
  if [[ "$command" == --remove ]]; then
    echo "wf: removed command for pane $slot in layout '$name'"
  else
    echo "wf: set command for pane $slot in layout '$name'"
  fi
}

# Print each newly created pane ID so callers can clean up on failure.
add_layout_panes() {
  local window="$1" count="$2" directory="$3" empty="$4"
  local index panes candidate width height extra area largest target direction new_pane
  local -a shell_args
  [[ "$empty" == yes ]] && shell_args=('')

  for (( index = 1; index < count; index++ )); do
    panes="$(tmux list-panes -t "$window" -F '#{pane_id} #{pane_width} #{pane_height}')" || return 1
    largest=0
    target=''
    while read -r candidate width height extra; do
      [[ "$width" == <-> && "$height" == <-> && -z "$extra" ]] || return 1
      area=$(( width * height ))
      if (( area > largest )); then
        largest=$area
        target="$candidate"
        if (( width > height )); then direction=-h; else direction=-v; fi
      fi
    done <<< "$panes"
    [[ -n "$target" ]] || return 1
    new_pane="$(tmux split-window "$direction" -d -P -F '#{pane_id}' -t "$target" -c "$directory" "${shell_args[@]}")" || return 1
    print -r -- "$new_pane"
    tmux select-layout -t "$window" tiled >/dev/null || return 1
  done
  return 0
}

load_layout() {
  local name="$1"
  local layout_count='' layout_geometry='' count layout
  local -A layout_commands
  local info original_pane window_id current_count session_id width height extra directory
  local staging='' created='' new_pane empty=no shell default_command startup slot pane_ids failed=0
  local -a ordered_panes
  local -a target_args

  if [[ -z "$TMUX" ]]; then
    echo 'wf: -layout must be run inside a tmux session' >&2
    return 1
  fi
  read_saved_layout "$name" || return 1
  count="$layout_count"
  layout="$layout_geometry"

  [[ -n "$TMUX_PANE" ]] && target_args=(-t "$TMUX_PANE")
  info="$(tmux display-message -p "${target_args[@]}" '#{pane_id} #{window_id} #{window_panes} #{session_id} #{window_width} #{window_height}')" || return 1
  read -r original_pane window_id current_count session_id width height extra <<< "$info"
  if [[ -z "$original_pane" || -z "$window_id" || -z "$session_id" || "$current_count" != <-> || "$width" != <-> || "$height" != <-> || -n "$extra" ]]; then
    echo 'wf: could not determine current window' >&2
    return 1
  fi
  if [[ "$current_count" != 1 ]]; then
    echo 'wf: -layout requires exactly 1 pane; try again with 1 pane in the current window' >&2
    return 1
  fi
  if (( count > width * height )); then
    echo "wf: layout '$name' has too many panes for this window" >&2
    return 1
  fi
  directory="$(tmux display-message -p -t "$original_pane" '#{pane_current_path}')" || return 1

  # Let tmux validate the geometry and available space in a detached, empty window.
  # No shells are launched there and the user's original window is untouched.
  {
    staging="$(tmux new-window -d -P -F '#{window_id}' -t "$session_id:" -n wf-layout-check -c "$directory" '')" || return 1
    tmux resize-window -t "$staging" -x "$width" -y "$height" || return 1
    if ! add_layout_panes "$staging" "$count" "$directory" yes >/dev/null ||
        ! tmux select-layout -t "$staging" "$layout" >/dev/null; then
      echo "wf: layout '$name' is invalid or does not fit this window" >&2
      return 1
    fi
  } always {
    [[ -z "$staging" ]] || tmux kill-window -t "$staging" >/dev/null 2>&1
  }

  if (( ${#layout_commands} > 0 )); then
    empty=yes
    shell="$(tmux display-message -p -t "$original_pane" '#{default-shell}')" || return 1
    default_command="$(tmux display-message -p -t "$original_pane" '#{default-command}')" || return 1
    [[ -n "$shell" ]] || return 1
  fi
  if ! created="$(add_layout_panes "$window_id" "$count" "$directory" "$empty")" ||
      ! tmux select-layout -t "$window_id" "$layout" >/dev/null; then
    # Roll back only panes created by this operation; never kill the original pane.
    for new_pane in "${(@f)created}"; do
      [[ -z "$new_pane" ]] || tmux kill-pane -t "$new_pane" >/dev/null 2>&1
    done
    tmux select-pane -t "$original_pane" >/dev/null 2>&1
    echo "wf: could not load layout '$name'; kept the original pane" >&2
    return 1
  fi
  tmux select-pane -t "$original_pane" || return 1
  if [[ "$empty" == yes ]]; then
    pane_ids="$(tmux list-panes -t "$window_id" -F '#{pane_id}')" || return 1
    ordered_panes=("${(@f)pane_ids}")
    for (( slot = 2; slot <= count; slot++ )); do
      new_pane="$ordered_panes[$slot]"
      if (( ${+layout_commands[$slot]} )); then
        # Run the configured command in a child login shell, then leave a shell.
        # Single-quote values for the shell without interpreting their contents.
        startup="${(qq)shell} -lc ${(qq)layout_commands[$slot]}; exec ${(qq)shell} -l"
        tmux respawn-pane -k -t "$new_pane" -c "$directory" "$shell" -c "$startup" || failed=1
      elif [[ -n "$default_command" ]]; then
        tmux respawn-pane -k -t "$new_pane" -c "$directory" "$default_command" || failed=1
      else
        tmux respawn-pane -k -t "$new_pane" -c "$directory" "$shell" -l || failed=1
      fi
    done
    if (( failed )); then
      echo "wf: layout loaded, but could not start all pane commands" >&2
      return 1
    fi
  fi
  echo "wf: loaded layout '$name' ($count panes)"
}

delete_layout() {
  local name="$1"
  local layout_file="${XDG_CONFIG_HOME:-$HOME/.config}/wf/layouts/$name.layout"

  if ! is_valid_session_name "$name"; then
    echo "wf: invalid layout name '$name'" >&2
    return 1
  fi
  if [[ ! -f "$layout_file" ]]; then
    echo "wf: saved layout '$name' not found" >&2
    return 1
  fi
  if ! rm -- "$layout_file"; then
    echo "wf: could not delete layout '$name'" >&2
    return 1
  fi
  echo "wf: deleted layout '$name'"
}

list_layouts() {
  local layout_dir="${XDG_CONFIG_HOME:-$HOME/.config}/wf/layouts"
  local file line pane_count found=0

  for file in "$layout_dir"/*.layout(N.on); do
    if (( found == 0 )); then
      printf '%-24s %s\n' 'LAYOUT' 'PANES'
      found=1
    fi
    pane_count='?'
    while IFS= read -r line; do
      if [[ "$line" == panes=* && "${line#panes=}" == <-> ]]; then
        pane_count="${line#panes=}"
        break
      fi
    done < "$file"
    printf '%-24s %s\n' "${file:t:r}" "$pane_count"
  done

  if (( found == 0 )); then
    echo 'wf: no saved layouts'
  fi
}

session_exists() {
  tmux has-session -t "=$1" 2>/dev/null
}

list_sessions() {
  local sessions
  local session_name display_name created_epoch created_date created_time window_count attached_status

  if ! sessions="$(tmux list-sessions -F '#S	#{session_created}	#{session_windows}	#{?session_attached,attached,}' 2>/dev/null)"; then
    echo "wf: no active sessions"
    return
  fi

  zmodload zsh/datetime

  printf "%-24s %-8s %-8s %7s  %s\n" "SESSION" "DATE" "TIME" "WINDOWS" "STATUS"
  print -r -- "$sessions" | sort -f | while IFS=$'\t' read -r session_name created_epoch window_count attached_status; do
    if (( ${#session_name} > 24 )); then
      display_name="${session_name[1,21]}..."
    else
      display_name="$session_name"
    fi

    created_date="$(strftime "%m-%d-%y" "$created_epoch")"
    created_time="$(strftime "%H:%M" "$created_epoch")"
    printf "%-24s %-8s %-8s %7s  %s\n" "$display_name" "$created_date" "$created_time" "$window_count" "$attached_status"
  done
}

list_repo_statuses() {
  local directory directory_name display_name branch repo_status found_repo

  found_repo=0

  for directory in ./*(/N); do
    if ! git -C "$directory" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      continue
    fi

    if (( found_repo == 0 )); then
      printf "%-24s %-24s %s\n" "DIRECTORY" "BRANCH" "STATUS"
      found_repo=1
    fi

    directory_name="${directory:t}"
    if (( ${#directory_name} > 24 )); then
      display_name="${directory_name[1,21]}..."
    else
      display_name="$directory_name"
    fi

    branch="$(git -C "$directory" branch --show-current 2>/dev/null)"
    if [[ -z "$branch" ]]; then
      branch="detached:$(git -C "$directory" rev-parse --short HEAD 2>/dev/null)"
    fi

    if [[ -n "$(git -C "$directory" status --porcelain 2>/dev/null)" ]]; then
      repo_status="uncommitted changes"
    else
      repo_status="up to date"
    fi

    printf "%-24s %-24s %s\n" "$display_name" "$branch" "$repo_status"
  done

  if (( found_repo == 0 )); then
    echo "wf: no git repositories found"
  fi
}

switch_or_attach() {
  local session_name="$1"

  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "=$session_name"
  else
    tmux attach-session -t "=$session_name"
  fi
}

create_default_session() {
  create_default_session_in_directory "$1" "$PWD"
}

create_default_session_in_directory() {
  local session_name="$1"
  local directory="$2"

  tmux new-session -d -s "$session_name" -n Main -c "$directory" &&
    tmux set-option -t "=$session_name:" @wf_directory "$directory"
}

is_valid_session_name() {
  local session_name="$1"

  [[ -n "$session_name" ]] &&
    [[ "$session_name" != "." ]] &&
    [[ "$session_name" != ".." ]] &&
    [[ "$session_name" =~ '^[A-Za-z0-9_-]+$' ]] &&
    has_alphanumeric "$session_name"
}

has_alphanumeric() {
  local session_name="$1"

  [[ "$session_name" =~ '[A-Za-z0-9]' ]]
}

session_name_from_directory_name() {
  local directory_name="$1"
  local session_name="${directory_name//[^A-Za-z0-9_-]/_}"

  if is_valid_session_name "$session_name"; then
    echo "$session_name"
    return 0
  fi

  return 1
}

session_name_from_current_directory() {
  session_name_from_directory_name "${PWD:t}"
}

session_name_from_home_directory() {
  session_name_from_directory_name "${HOME:t}"
}

print_invalid_session_name() {
  local session_name="$1"

  echo "wf: invalid session name '$session_name'" >&2
  echo "wf: session names may only contain letters, numbers, '_', and '-'" >&2
  echo "wf: session names must contain at least one letter or number" >&2
  echo "wf: session names may not be '.' or '..'" >&2
}

create_session_from_current_directory() {
  local directory_name="${PWD:t}"
  local session_name

  if ! session_name="$(session_name_from_current_directory)"; then
    echo "wf: could not derive a safe session name from '$directory_name'" >&2
    echo "wf: directory names must contain at least one letter or number" >&2
    return 1
  fi

  if session_exists "$session_name"; then
    echo "wf: session already exists" >&2
    return 1
  fi

  if ! create_default_session "$session_name"; then
    echo "wf: failed to create session '$session_name'" >&2
    return 1
  fi

  switch_or_attach "$session_name"
}

create_or_enter_path_session() {
  local directory="$1"
  local session_name existing_directory

  # Handle quoted tilde paths without evaluating shell expressions.
  if [[ "$directory" == "~" ]]; then
    directory="$HOME"
  elif [[ "$directory" == '~/'* ]]; then
    directory="$HOME/${directory#\~/}"
  fi

  if [[ -z "$directory" || ! -d "$directory" ]]; then
    echo "wf: directory does not exist: '$directory'" >&2
    return 1
  fi

  directory="${directory:A}"
  if ! session_name="$(session_name_from_directory_name "${directory:t}")"; then
    echo "wf: could not derive a safe session name from '$directory'" >&2
    return 1
  fi

  if session_exists "$session_name"; then
    if ! existing_directory="$(tmux display-message -p -t "=$session_name:" '#{?@wf_directory,#{@wf_directory},#{session_path}}')"; then
      echo "wf: could not determine directory for session '$session_name'" >&2
      return 1
    fi

    if [[ -z "$existing_directory" || "${existing_directory:A}" != "$directory" ]]; then
      echo "wf: session '$session_name' belongs to a different directory: '$existing_directory'" >&2
      return 1
    fi
  elif ! create_default_session_in_directory "$session_name" "$directory"; then
    echo "wf: failed to create session '$session_name'" >&2
    return 1
  fi

  switch_or_attach "$session_name"
}

create_or_enter_home_session() {
  local directory_name="${HOME:t}"
  local session_name

  if ! session_name="$(session_name_from_home_directory)"; then
    echo "wf: could not derive a safe session name from '$directory_name'" >&2
    echo "wf: home directory name must contain at least one letter or number" >&2
    return 1
  fi

  if ! session_exists "$session_name"; then
    if ! create_default_session_in_directory "$session_name" "$HOME"; then
      echo "wf: failed to create session '$session_name'" >&2
      return 1
    fi
  fi

  switch_or_attach "$session_name"
}

delete_session() {
  local session_name="$1"
  local prompt="$2"

  printf "%s" "$prompt"
  read -r -k 1 REPLY
  echo

  if [[ "$REPLY" == [yY] ]]; then
    tmux kill-session -t "=$session_name"
    echo "wf: deleted session '$session_name'"
  else
    echo "wf: delete cancelled"
  fi
}

delete_current_session() {
  local session_name

  if [[ -z "$TMUX" ]]; then
    echo "wf: -d requires a session name outside tmux" >&2
    return 1
  fi

  if ! session_name="$(tmux display-message -p '#S')"; then
    echo "wf: could not determine current session" >&2
    return 1
  fi

  delete_session "$session_name" "wf: delete current session '$session_name'? [y/N] "
}

detach_current_client() {
  if [[ -z "$TMUX" ]]; then
    echo "wf: -x must be run inside a tmux session" >&2
    return 1
  fi

  tmux detach-client
}

split_current_pane() {
  local command="$1"
  local direction="-h"

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  if [[ "$command" == "-S" ]]; then
    direction="-v"
  fi

  tmux split-window "$direction" -c '#{pane_current_path}'
}

create_pane_layout() {
  local command="$1"
  local pane_count original_pane new_pane directory

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  if ! pane_count="$(tmux display-message -p '#{window_panes}')"; then
    echo "wf: could not determine pane count" >&2
    return 1
  fi

  if [[ "$pane_count" != "1" ]]; then
    echo "wf: $command requires exactly 1 pane; try again with 1 pane in the current window" >&2
    return 1
  fi

  original_pane="$(tmux display-message -p '#{pane_id}')" || return 1
  directory="$(tmux display-message -p '#{pane_current_path}')" || return 1

  if [[ "$command" == "-tri" || "$command" == "-t" ]]; then
    # Keep the left pane full-height and split the right half into two rows.
    new_pane="$(tmux split-window -h -d -P -F '#{pane_id}' -t "$original_pane" -c "$directory")" || return 1
    tmux split-window -v -d -t "$new_pane" -c "$directory" || return 1
  else
    # Split into rows, then split each row to keep indexes in reading order.
    new_pane="$(tmux split-window -v -d -P -F '#{pane_id}' -t "$original_pane" -c "$directory")" || return 1
    tmux split-window -h -d -t "$original_pane" -c "$directory" || return 1
    tmux split-window -h -d -t "$new_pane" -c "$directory" || return 1
  fi
  tmux set-option -w -t "$original_pane" pane-base-index 1 || return 1
  tmux select-pane -t "$original_pane"
}

break_current_pane() {
  local command="$1"
  local info pane_id pane_count session_id extra
  local -a target_args

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi
  if ! info="$(tmux display-message -p "${target_args[@]}" '#{pane_id} #{window_panes} #{session_id}')"; then
    echo "wf: could not determine current pane" >&2
    return 1
  fi
  read -r pane_id pane_count session_id extra <<< "$info"
  if [[ -z "$pane_id" || "$pane_count" != <-> || -z "$session_id" || -n "$extra" ]]; then
    echo "wf: could not determine current pane" >&2
    return 1
  fi
  if (( pane_count < 2 )); then
    echo "wf: $command requires at least 2 panes in the current window" >&2
    return 1
  fi

  tmux break-pane -s "$pane_id" -t "$session_id:"
}

join_current_pane() {
  local command="$1" destination="$2"
  local info pane_id session_id source_window extra windows
  local index window_id window_name destination_window matches=0 destination_pane
  local pane_positions left top direction=-h destination_count
  local -a target_args destination_panes pane_lefts pane_tops

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi
  if [[ -z "$destination" ]]; then
    echo "Usage: wf $command <destination>" >&2
    return 1
  fi

  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi
  if ! info="$(tmux display-message -p "${target_args[@]}" '#{pane_id} #{session_id} #{window_id}')"; then
    echo "wf: could not determine current pane" >&2
    return 1
  fi
  read -r pane_id session_id source_window extra <<< "$info"
  if [[ -z "$pane_id" || -z "$session_id" || -z "$source_window" || -n "$extra" ]]; then
    echo "wf: could not determine current pane" >&2
    return 1
  fi
  if ! windows="$(tmux list-windows -t "$session_id" -F $'#{window_index}\t#{window_id}\t#{window_name}')"; then
    echo "wf: could not list workspace windows" >&2
    return 1
  fi

  # Numeric destinations are indexes; other destinations must match a full name.
  while IFS=$'\t' read -r index window_id window_name; do
    if { [[ "$destination" == <-> && "$destination" == "$index" ]] ||
         [[ "$destination" != <-> && "$destination" == "$window_name" ]]; }; then
      destination_window="$window_id"
      (( matches += 1 ))
    fi
  done <<< "$windows"

  if (( matches == 0 )); then
    echo "wf: destination window '$destination' does not exist in this workspace" >&2
    return 1
  elif (( matches > 1 )); then
    echo "wf: destination window '$destination' is ambiguous; use its window number" >&2
    return 1
  elif [[ "$destination_window" == "$source_window" ]]; then
    echo "wf: destination must be a different window" >&2
    return 1
  fi

  pane_positions="$(tmux list-panes -t "$session_id:$destination_window" -F $'#{pane_id}\t#{pane_left}\t#{pane_top}')" || return 1
  while IFS=$'\t' read -r destination_pane left top; do
    if [[ -z "$destination_pane" || "$left" != <-> || "$top" != <-> ]]; then
      echo "wf: could not determine destination layout" >&2
      return 1
    fi
    destination_panes+=("$destination_pane")
    pane_lefts+=("$left")
    pane_tops+=("$top")
  done <<< "$pane_positions"
  destination_count=${#destination_panes}

  case "$destination_count" in
    1)
      destination_pane="$destination_panes[1]"
      ;;
    2)
      if [[ "$pane_tops[1]" == "$pane_tops[2]" ]]; then
        # Side-by-side: join below the right pane to form a triple layout.
        direction=-v
        if (( pane_lefts[1] > pane_lefts[2] )); then
          destination_pane="$destination_panes[1]"
        else
          destination_pane="$destination_panes[2]"
        fi
      else
        # Stacked: join to the right of the bottom pane.
        if (( pane_tops[1] > pane_tops[2] )); then
          destination_pane="$destination_panes[1]"
        else
          destination_pane="$destination_panes[2]"
        fi
      fi
      ;;
    3)
      # Append the incoming pane so tiled layout places it bottom-right.
      destination_pane="$destination_panes[-1]"
      ;;
    *)
      destination_pane="$(tmux display-message -p -t "$session_id:$destination_window" '#{pane_id}')" || return 1
      ;;
  esac

  [[ -n "$destination_pane" ]] || return 1
  tmux join-pane "$direction" -s "$pane_id" -t "$destination_pane" || return 1
  if (( destination_count == 3 )); then
    tmux select-layout -t "$destination_window" tiled >/dev/null || return 1
  fi
}

close_current_pane() {
  local pane_count

  if [[ -z "$TMUX" ]]; then
    echo "wf: -cs must be run inside a tmux session" >&2
    return 1
  fi

  if ! pane_count="$(tmux display-message -p '#{window_panes}')"; then
    echo "wf: could not determine pane count" >&2
    return 1
  fi

  if [[ "$pane_count" != <-> ]]; then
    echo "wf: could not determine pane count" >&2
    return 1
  fi

  if (( pane_count <= 1 )); then
    echo "wf: cannot close the last pane in a window" >&2
    return 1
  fi

  tmux kill-pane
}

close_other_panes() {
  local pane_id="$TMUX_PANE"

  if [[ -z "$TMUX" ]]; then
    echo "wf: -cas must be run inside a tmux session" >&2
    return 1
  fi

  if [[ -z "$pane_id" ]]; then
    pane_id="$(tmux display-message -p '#{pane_id}')" || return 1
  fi

  if [[ -z "$pane_id" ]]; then
    echo "wf: could not determine current pane" >&2
    return 1
  fi

  tmux kill-pane -a -t "$pane_id"
}

close_other_windows() {
  local target_window
  local -a target_args

  if [[ -z "$TMUX" ]]; then
    echo "wf: -caw must be run inside a tmux session" >&2
    return 1
  fi

  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi

  if ! target_window="$(tmux display-message -p "${target_args[@]}" '#{session_id}:#{window_id}')"; then
    echo "wf: could not determine current window" >&2
    return 1
  fi

  if [[ -z "$target_window" || "$target_window" == ":" ]]; then
    echo "wf: could not determine current window" >&2
    return 1
  fi

  tmux kill-window -a -t "$target_window"
}

create_window() {
  local command="$1"
  local directory="$PWD"
  local count="${2:-1}"
  local index

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  if (( count == 0 )); then
    return 0
  fi

  if [[ "$command" == "-N" ]]; then
    if ! directory="$(tmux display-message -p '#{?@wf_directory,#{@wf_directory},#{session_path}}')"; then
      echo "wf: could not determine workspace directory" >&2
      return 1
    fi
  fi

  if [[ -z "$directory" || ! -d "$directory" ]]; then
    echo "wf: window directory does not exist: '$directory'" >&2
    return 1
  fi

  for (( index = 0; index < count; index++ )); do
    tmux new-window -c "$directory" || return 1
  done
}

close_current_window() {
  local window_count

  if [[ -z "$TMUX" ]]; then
    echo "wf: -cw must be run inside a tmux session" >&2
    return 1
  fi

  if ! window_count="$(tmux display-message -p '#{session_windows}')"; then
    echo "wf: could not determine window count" >&2
    return 1
  fi

  if [[ "$window_count" != <-> ]]; then
    echo "wf: could not determine window count" >&2
    return 1
  fi

  if (( window_count <= 1 )); then
    echo "wf: cannot close the last window in a session; use 'wf -d' to delete the workspace" >&2
    return 1
  fi

  tmux kill-window
}

focus_current_pane() {
  local command="$1"
  local info pane_id window_id zoomed extra panes candidate left top width height
  local primary_pane primary_left primary_top primary_area area preferred pane_count
  local -a target_args

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi
  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi
  if ! info="$(tmux display-message -p "${target_args[@]}" '#{pane_id} #{window_id} #{window_zoomed_flag} #{window_panes}')"; then
    echo "wf: could not determine current pane" >&2
    return 1
  fi
  read -r pane_id window_id zoomed pane_count extra <<< "$info"
  if [[ -z "$pane_id" || -z "$window_id" || "$zoomed" != [01] || "$pane_count" != <-> || -n "$extra" ]]; then
    echo "wf: could not determine current pane" >&2
    return 1
  fi
  (( pane_count == 1 )) && return 0
  if (( pane_count < 2 || pane_count > 4 )); then
    echo "wf: $command supports only 1–4 panes in the current window" >&2
    return 1
  fi

  # Work on the underlying layout, restoring zoom even if a command fails.
  if [[ "$zoomed" == 1 ]]; then
    tmux resize-pane -Z -t "$pane_id" || return 1
  fi
  {
    panes="$(tmux list-panes -t "$window_id" -F '#{pane_id} #{pane_left} #{pane_top} #{pane_width} #{pane_height}')" || return 1
    while read -r candidate left top width height extra; do
      if [[ -z "$candidate" || "$left" != <-> || "$top" != <-> || "$width" != <-> || "$height" != <-> || -n "$extra" ]]; then
        echo "wf: could not determine pane layout" >&2
        return 1
      fi
      area=$(( width * height ))
      preferred=0
      if [[ -z "$primary_pane" ]]; then
        preferred=1
      elif (( pane_count == 3 && area > primary_area )); then
        preferred=1
      elif (( pane_count != 3 || area == primary_area )); then
        if (( top < primary_top || (top == primary_top && left < primary_left) )); then
          preferred=1
        fi
      fi
      if (( preferred )); then
        primary_pane="$candidate"
        primary_left="$left"
        primary_top="$top"
        primary_area="$area"
      fi
    done <<< "$panes"

    if [[ "$primary_pane" != "$pane_id" ]]; then
      tmux swap-pane -s "$pane_id" -t "$primary_pane" || return 1
      tmux select-pane -t "$pane_id" || return 1
    fi
  } always {
    if [[ "$zoomed" == 1 ]]; then
      tmux resize-pane -Z -t "$pane_id"
    fi
  }
}

reset_pane_layout() {
  local command="$1"
  local expected_count=4
  local pane_count window_id window_width info extra pane_ids main_pane main_width positions layout
  local -a target_args pane_tops

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  [[ "$command" == "-rt" || "$command" == "-r3" ]] && expected_count=3
  [[ "$command" == "-rd" || "$command" == "-r2" ]] && expected_count=2
  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi
  if ! info="$(tmux display-message -p "${target_args[@]}" '#{window_id} #{window_panes} #{window_width}')"; then
    echo "wf: could not determine current window" >&2
    return 1
  fi
  read -r window_id pane_count window_width extra <<< "$info"
  if [[ -z "$window_id" || "$pane_count" != <-> || "$window_width" != <-> || -n "$extra" ]]; then
    echo "wf: could not determine current window" >&2
    return 1
  fi
  if (( pane_count != expected_count )); then
    echo "wf: $command requires exactly $expected_count panes in the current window" >&2
    return 1
  fi

  if [[ "$command" == "-rd" || "$command" == "-r2" ]]; then
    positions="$(tmux list-panes -t "$window_id" -F '#{pane_top}')" || return 1
    pane_tops=("${(@f)positions}")
    if (( ${#pane_tops} != 2 )) || [[ "$pane_tops[1]" != <-> || "$pane_tops[2]" != <-> ]]; then
      echo "wf: could not determine pane orientation" >&2
      return 1
    fi
    if [[ "$pane_tops[1]" == "$pane_tops[2]" ]]; then
      layout=even-horizontal
    else
      layout=even-vertical
    fi
    tmux select-layout -t "$window_id" "$layout" >/dev/null || return 1
  elif [[ "$command" == "-rq" || "$command" == "-r4" ]]; then
    tmux select-layout -t "$window_id" tiled >/dev/null || return 1
  else
    pane_ids="$(tmux list-panes -t "$window_id" -F '#{pane_id}')" || return 1
    main_pane="${${(f)pane_ids}[1]}"
    [[ -n "$main_pane" ]] || return 1
    # Exclude the separator column, giving the left pane half of usable width.
    main_width=$(( (window_width - 1) / 2 ))
    tmux select-layout -t "$window_id" main-vertical >/dev/null || return 1
    tmux resize-pane -t "$main_pane" -x "$main_width" || return 1
  fi
  tmux set-option -w -t "$window_id" pane-base-index 1
}

is_valid_resize_value() {
  local value="$1"
  local digits

  if [[ "$value" =~ '^\+?(100|[0-9]{1,2})%$' ]]; then
    digits="${value%\%}"
    digits="${digits#+}"
    (( 10#$digits >= 1 ))
  else
    [[ "$value" =~ '^[+-]?(100|[0-9]{1,2})$' ]]
  fi
}

resize_current_pane() {
  local x="$1" y="$2"
  local pane_id pane_count pane_width pane_height extra info
  local value digits amount target dimension
  local -a target_args resize_args

  if ! is_valid_resize_value "$x" || ! is_valid_resize_value "$y"; then
    echo "wf: x and y must be integers from -100 to 100 or absolute percentages from 1% to 100%" >&2
    return 1
  fi

  if [[ -z "$TMUX" ]]; then
    echo "wf: -r must be run inside a tmux session" >&2
    return 1
  fi

  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi
  if ! info="$(tmux display-message -p "${target_args[@]}" '#{pane_id} #{window_panes} #{pane_width} #{pane_height}')"; then
    echo "wf: could not determine current pane dimensions" >&2
    return 1
  fi
  read -r pane_id pane_count pane_width pane_height extra <<< "$info"
  if [[ -z "$pane_id" || "$pane_count" != <-> || "$pane_width" != <-> || "$pane_height" != <-> || -n "$extra" ]]; then
    echo "wf: could not determine current pane dimensions" >&2
    return 1
  fi

  for dimension in x y; do
    if [[ "$dimension" == x ]]; then
      value="$x"
      target="$pane_width"
    else
      value="$y"
      target="$pane_height"
    fi

    if [[ "$value" == *% ]]; then
      digits="${value%\%}"
      digits="${digits#+}"
      resize_args+=("-$dimension" "$(( 10#$digits ))%")
    else
      digits="${value#[+-]}"
      amount=$(( 10#$digits ))
      [[ "$value" == -* ]] && amount=$(( -amount ))
      (( amount == 0 )) && continue
      target=$(( target + amount ))
      (( target < 1 )) && target=1
      resize_args+=("-$dimension" "$target")
    fi
  done

  (( ${#resize_args} == 0 )) && return 0
  if (( pane_count < 2 )); then
    echo "wf: -r requires at least 2 panes in the current window" >&2
    return 1
  fi

  tmux resize-pane -t "$pane_id" "${resize_args[@]}"
}

show_help() {
  cat <<'EOF'
wf - Workspace Flow

  wf                    List active workspaces.
  wf <name>             Create or enter a workspace.
  wf .                  Create a workspace named after the current directory.
  wf ~                  Create or enter a workspace in your home directory.
  wf -p <directory>     Create or enter a workspace at a path; reject name conflicts.
  wf -d [name]          Confirm and delete a workspace; defaults to current workspace.
  wf -git               Show Git branch and changes for child directories.
  wf -layouts           List saved layouts and their pane counts.
  wf -delete-layout <name> Delete a saved layout; running panes are unaffected.
  wf -layout-cmd <name> <pane> <command|--remove> Set, replace or remove a startup command.
  wf --help, -h         Show this help.

Inside a workspace:
  wf -save-layout <name> Save this window's pane arrangement without overwriting a name.
  wf -layout <name> Build a saved layout around this pane; requires exactly 1 pane.
  wf -x                 Detach from the workspace.
  wf -n [0-5]           New window(s) here; defaults to 1.
  wf -N [0-5]           New window(s) at the workspace directory; defaults to 1.
  wf -s                 Split left/right in the current pane's directory.
  wf -S                 Split top/bottom in the current pane's directory.
  wf -m, -max           Toggle pane zoom; restore the previous layout when unzoomed.
  wf -f, -focus         Move into largest triple slot or top left; preserve layout sizes.
  wf -b, -break         Move this pane to a new window and follow it; requires 2+ panes.
  wf -j, -join <dest>   Move this pane into another window here (number or exact name).
  wf -r <x> <y>         Resize: cells -100..100, absolute sizes 1%..100%; 0 keeps size.
  wf -r2, -rd           Reset 2 panes to equal sizes; keep orientation, panes and focus.
  wf -r4, -rq           Reset 4 panes to an equal 2x2 grid; keep panes and focus.
  wf -r3, -rt           Reset 3 panes to half-width left and stacked right; keep focus.
  wf -t, -tri           Left 1, top right 2, bottom right 3; requires 1 pane.
  wf -q, -quad          2x2 grid layout; requires 1 pane.
  wf -cs                Close this pane; protect the last pane.
  wf -cas               Close all other panes and their programs in this window.
  wf -cw                Close this window and its programs; protect the last window.
  wf -caw               Close all other windows and their programs in this workspace.
  wf -l, -label <name>  Add a custom label to the current window.
  wf -nl, -nolabel      Remove the custom label and resume automatic window naming.
EOF
}

main() {
  local command="$1"

  case "$command" in
    "")
      list_sessions
      ;;

    --help|-h)
      show_help
      ;;

    -layout-cmd)
      if (( $# < 4 )) || { [[ "$4" == --remove ]] && (( $# != 4 )); }; then
        echo "Usage: wf -layout-cmd <name> <pane> <command|--remove>" >&2
        return 1
      fi
      local layout_name="$2" layout_slot="$3"
      shift 3
      set_layout_command "$layout_name" "$layout_slot" "$*"
      ;;

    -delete-layout)
      if (( $# != 2 )); then
        echo "Usage: wf -delete-layout <name>" >&2
        return 1
      fi

      delete_layout "$2"
      ;;

    -layouts)
      if (( $# != 1 )); then
        echo "Usage: wf -layouts" >&2
        return 1
      fi

      list_layouts
      ;;

    -layout)
      if (( $# != 2 )); then
        echo "Usage: wf -layout <name>" >&2
        return 1
      fi

      load_layout "$2"
      ;;

    -save-layout)
      if (( $# != 2 )); then
        echo "Usage: wf -save-layout <name>" >&2
        return 1
      fi

      save_layout "$2"
      ;;

    -p)
      if (( $# != 2 )); then
        echo "Usage: wf -p <directory>" >&2
        return 1
      fi

      create_or_enter_path_session "$2"
      ;;

    -git)
      if (( $# != 1 )); then
        echo "Usage: wf -git" >&2
        return 1
      fi

      list_repo_statuses
      ;;

    -rd|-rq|-rt|-r2|-r3|-r4)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      reset_pane_layout "$command"
      ;;

    -j|-join)
      if (( $# != 2 )); then
        echo "Usage: wf $command <destination>" >&2
        return 1
      fi

      join_current_pane "$command" "$2"
      ;;

    -b|-break)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      break_current_pane "$command"
      ;;

    -f|-focus)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      focus_current_pane "$command"
      ;;

    -m|-max)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      if [[ -z "$TMUX" ]]; then
        echo "wf: $command must be run inside a tmux session" >&2
        return 1
      fi

      local -a zoom_target
      if [[ -n "$TMUX_PANE" ]]; then
        zoom_target=(-t "$TMUX_PANE")
      fi
      tmux resize-pane -Z "${zoom_target[@]}"
      ;;

    -r)
      if (( $# != 3 )); then
        echo "Usage: wf -r <x> <y>" >&2
        return 1
      fi

      resize_current_pane "$2" "$3"
      ;;

    -l|-label)
      shift
      local window_label="$*"

      if [[ -z "$TMUX" ]]; then
        echo "wf: $command must be run inside a tmux session" >&2
        return 1
      fi

      if [[ -z "$window_label" ]]; then
        echo "Usage: wf $command <window_name>" >&2
        return 1
      fi

      tmux rename-window "$window_label"
      ;;

    -nl|-nolabel)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      if [[ -z "$TMUX" ]]; then
        echo "wf: $command must be run inside a tmux session" >&2
        return 1
      fi

      tmux set-window-option automatic-rename on
      ;;

    -d)
      local session_name="$2"

      if (( $# == 1 )); then
        delete_current_session
        return
      fi

      if (( $# != 2 )); then
        echo "Usage: wf -d [session_name]" >&2
        return 1
      fi

      if ! is_valid_session_name "$session_name"; then
        print_invalid_session_name "$session_name"
        return 1
      fi

      if ! session_exists "$session_name"; then
        echo "wf: session '$session_name' does not exist" >&2
        return 1
      fi

      delete_session "$session_name" "wf: delete '$session_name'? [y/N] "
      ;;

    -n|-N)
      if (( $# > 2 )); then
        echo "Usage: wf $command [n]" >&2
        return 1
      fi

      local count="${2-1}"
      if [[ ! "$count" =~ '^[0-5]$' ]]; then
        echo "wf: window count must be a whole number from 0 to 5" >&2
        return 1
      fi

      create_window "$command" "$count"
      ;;

    -cw)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      close_current_window
      ;;

    -q|-quad|-t|-tri)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      create_pane_layout "$command"
      ;;

    -cas|-caw)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      if [[ "$command" == "-caw" ]]; then
        close_other_windows
      else
        close_other_panes
      fi
      ;;

    -s|-S|-cs)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      if [[ "$command" == "-cs" ]]; then
        close_current_pane
      else
        split_current_pane "$command"
      fi
      ;;

    -x)
      if (( $# != 1 )); then
        echo "Usage: wf -x" >&2
        return 1
      fi

      detach_current_client
      ;;

    -*)
      echo "wf: unknown option '$command'" >&2
      echo "wf: run 'wf --help' for usage" >&2
      return 1
      ;;

    *)
      if (( $# != 1 )); then
        echo "Usage: wf <session_name>" >&2
        return 1
      fi

      if [[ "$command" == "." ]]; then
        create_session_from_current_directory
        return
      fi

      if [[ "$command" == "~" || "$command" == "$HOME" ]]; then
        create_or_enter_home_session
        return
      fi

      local session_name="$command"

      if ! is_valid_session_name "$session_name"; then
        print_invalid_session_name "$session_name"
        return 1
      fi

      if ! session_exists "$session_name"; then
        if ! create_default_session "$session_name"; then
          echo "wf: failed to create session '$session_name'" >&2
          return 1
        fi
      fi

      switch_or_attach "$session_name"
      ;;
  esac
}

main "$@"
