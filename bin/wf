#!/usr/bin/env zsh

# wf - Workspace Flow
# A lightweight tmux workspace manager

session_exists() {
  tmux has-session -t "=$1" 2>/dev/null
}

list_sessions() {
  local sessions
  local session_name display_name created_epoch created_date created_time window_count attached_status

  if ! sessions="$(tmux list-sessions -F '#S	#{session_created}	#{session_windows}	#{?session_attached,attached,}' 2>/dev/null)"; then
    echo "wf: no active sessions"
    return
  fi

  zmodload zsh/datetime

  printf "%-24s %-8s %-8s %7s  %s\n" "SESSION" "DATE" "TIME" "WINDOWS" "STATUS"
  print -r -- "$sessions" | sort -f | while IFS=$'\t' read -r session_name created_epoch window_count attached_status; do
    if (( ${#session_name} > 24 )); then
      display_name="${session_name[1,21]}..."
    else
      display_name="$session_name"
    fi

    created_date="$(strftime "%m-%d-%y" "$created_epoch")"
    created_time="$(strftime "%H:%M" "$created_epoch")"
    printf "%-24s %-8s %-8s %7s  %s\n" "$display_name" "$created_date" "$created_time" "$window_count" "$attached_status"
  done
}

list_repo_statuses() {
  local directory directory_name display_name branch repo_status found_repo

  found_repo=0

  for directory in ./*(/N); do
    if ! git -C "$directory" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      continue
    fi

    if (( found_repo == 0 )); then
      printf "%-24s %-24s %s\n" "DIRECTORY" "BRANCH" "STATUS"
      found_repo=1
    fi

    directory_name="${directory:t}"
    if (( ${#directory_name} > 24 )); then
      display_name="${directory_name[1,21]}..."
    else
      display_name="$directory_name"
    fi

    branch="$(git -C "$directory" branch --show-current 2>/dev/null)"
    if [[ -z "$branch" ]]; then
      branch="detached:$(git -C "$directory" rev-parse --short HEAD 2>/dev/null)"
    fi

    if [[ -n "$(git -C "$directory" status --porcelain 2>/dev/null)" ]]; then
      repo_status="uncommitted changes"
    else
      repo_status="up to date"
    fi

    printf "%-24s %-24s %s\n" "$display_name" "$branch" "$repo_status"
  done

  if (( found_repo == 0 )); then
    echo "wf: no git repositories found"
  fi
}

switch_or_attach() {
  local session_name="$1"

  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "=$session_name"
  else
    tmux attach-session -t "=$session_name"
  fi
}

create_default_session() {
  create_default_session_in_directory "$1" "$PWD"
}

create_default_session_in_directory() {
  local session_name="$1"
  local directory="$2"

  tmux new-session -d -s "$session_name" -c "$directory" &&
    tmux set-option -t "=$session_name:" @wf_directory "$directory"
}

is_valid_session_name() {
  local session_name="$1"

  [[ -n "$session_name" ]] &&
    [[ "$session_name" != "." ]] &&
    [[ "$session_name" != ".." ]] &&
    [[ "$session_name" =~ '^[A-Za-z0-9_-]+$' ]] &&
    has_alphanumeric "$session_name"
}

has_alphanumeric() {
  local session_name="$1"

  [[ "$session_name" =~ '[A-Za-z0-9]' ]]
}

session_name_from_directory_name() {
  local directory_name="$1"
  local session_name="${directory_name//[^A-Za-z0-9_-]/_}"

  if is_valid_session_name "$session_name"; then
    echo "$session_name"
    return 0
  fi

  return 1
}

session_name_from_current_directory() {
  session_name_from_directory_name "${PWD:t}"
}

session_name_from_home_directory() {
  session_name_from_directory_name "${HOME:t}"
}

print_invalid_session_name() {
  local session_name="$1"

  echo "wf: invalid session name '$session_name'" >&2
  echo "wf: session names may only contain letters, numbers, '_', and '-'" >&2
  echo "wf: session names must contain at least one letter or number" >&2
  echo "wf: session names may not be '.' or '..'" >&2
}

create_session_from_current_directory() {
  local directory_name="${PWD:t}"
  local session_name

  if ! session_name="$(session_name_from_current_directory)"; then
    echo "wf: could not derive a safe session name from '$directory_name'" >&2
    echo "wf: directory names must contain at least one letter or number" >&2
    return 1
  fi

  if session_exists "$session_name"; then
    echo "wf: session already exists" >&2
    return 1
  fi

  if ! create_default_session "$session_name"; then
    echo "wf: failed to create session '$session_name'" >&2
    return 1
  fi

  switch_or_attach "$session_name"
}

create_or_enter_path_session() {
  local directory="$1"
  local session_name existing_directory

  # Handle quoted tilde paths without evaluating shell expressions.
  if [[ "$directory" == "~" ]]; then
    directory="$HOME"
  elif [[ "$directory" == '~/'* ]]; then
    directory="$HOME/${directory#\~/}"
  fi

  if [[ -z "$directory" || ! -d "$directory" ]]; then
    echo "wf: directory does not exist: '$directory'" >&2
    return 1
  fi

  directory="${directory:A}"
  if ! session_name="$(session_name_from_directory_name "${directory:t}")"; then
    echo "wf: could not derive a safe session name from '$directory'" >&2
    return 1
  fi

  if session_exists "$session_name"; then
    if ! existing_directory="$(tmux display-message -p -t "=$session_name:" '#{?@wf_directory,#{@wf_directory},#{session_path}}')"; then
      echo "wf: could not determine directory for session '$session_name'" >&2
      return 1
    fi

    if [[ -z "$existing_directory" || "${existing_directory:A}" != "$directory" ]]; then
      echo "wf: session '$session_name' belongs to a different directory: '$existing_directory'" >&2
      return 1
    fi
  elif ! create_default_session_in_directory "$session_name" "$directory"; then
    echo "wf: failed to create session '$session_name'" >&2
    return 1
  fi

  switch_or_attach "$session_name"
}

create_or_enter_home_session() {
  local directory_name="${HOME:t}"
  local session_name

  if ! session_name="$(session_name_from_home_directory)"; then
    echo "wf: could not derive a safe session name from '$directory_name'" >&2
    echo "wf: home directory name must contain at least one letter or number" >&2
    return 1
  fi

  if ! session_exists "$session_name"; then
    if ! create_default_session_in_directory "$session_name" "$HOME"; then
      echo "wf: failed to create session '$session_name'" >&2
      return 1
    fi
  fi

  switch_or_attach "$session_name"
}

delete_session() {
  local session_name="$1"
  local prompt="$2"

  printf "%s" "$prompt"
  read -r -k 1 REPLY
  echo

  if [[ "$REPLY" == [yY] ]]; then
    tmux kill-session -t "=$session_name"
    echo "wf: deleted session '$session_name'"
  else
    echo "wf: delete cancelled"
  fi
}

delete_current_session() {
  local session_name

  if [[ -z "$TMUX" ]]; then
    echo "wf: -d requires a session name outside tmux" >&2
    return 1
  fi

  if ! session_name="$(tmux display-message -p '#S')"; then
    echo "wf: could not determine current session" >&2
    return 1
  fi

  delete_session "$session_name" "wf: delete current session '$session_name'? [y/N] "
}

detach_current_client() {
  if [[ -z "$TMUX" ]]; then
    echo "wf: -x must be run inside a tmux session" >&2
    return 1
  fi

  tmux detach-client
}

split_current_pane() {
  local command="$1"
  local direction="-h"

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  if [[ "$command" == "-S" ]]; then
    direction="-v"
  fi

  tmux split-window "$direction" -c '#{pane_current_path}'
}

create_pane_layout() {
  local command="$1"
  local pane_count original_pane new_pane directory

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  if ! pane_count="$(tmux display-message -p '#{window_panes}')"; then
    echo "wf: could not determine pane count" >&2
    return 1
  fi

  if [[ "$pane_count" != "1" ]]; then
    echo "wf: $command requires exactly 1 pane; try again with 1 pane in the current window" >&2
    return 1
  fi

  original_pane="$(tmux display-message -p '#{pane_id}')" || return 1
  directory="$(tmux display-message -p '#{pane_current_path}')" || return 1

  if [[ "$command" == "-tri" || "$command" == "-t" ]]; then
    # Keep the left pane full-height and split the right half into two rows.
    new_pane="$(tmux split-window -h -d -P -F '#{pane_id}' -t "$original_pane" -c "$directory")" || return 1
    tmux split-window -v -d -t "$new_pane" -c "$directory" || return 1
  else
    # Split into rows, then split each row to keep indexes in reading order.
    new_pane="$(tmux split-window -v -d -P -F '#{pane_id}' -t "$original_pane" -c "$directory")" || return 1
    tmux split-window -h -d -t "$original_pane" -c "$directory" || return 1
    tmux split-window -h -d -t "$new_pane" -c "$directory" || return 1
  fi
  tmux set-option -w -t "$original_pane" pane-base-index 1 || return 1
  tmux select-pane -t "$original_pane"
}

close_current_pane() {
  local pane_count

  if [[ -z "$TMUX" ]]; then
    echo "wf: -cs must be run inside a tmux session" >&2
    return 1
  fi

  if ! pane_count="$(tmux display-message -p '#{window_panes}')"; then
    echo "wf: could not determine pane count" >&2
    return 1
  fi

  if [[ "$pane_count" != <-> ]]; then
    echo "wf: could not determine pane count" >&2
    return 1
  fi

  if (( pane_count <= 1 )); then
    echo "wf: cannot close the last pane in a window" >&2
    return 1
  fi

  tmux kill-pane
}

close_other_panes() {
  local pane_id="$TMUX_PANE"

  if [[ -z "$TMUX" ]]; then
    echo "wf: -cas must be run inside a tmux session" >&2
    return 1
  fi

  if [[ -z "$pane_id" ]]; then
    pane_id="$(tmux display-message -p '#{pane_id}')" || return 1
  fi

  if [[ -z "$pane_id" ]]; then
    echo "wf: could not determine current pane" >&2
    return 1
  fi

  tmux kill-pane -a -t "$pane_id"
}

close_other_windows() {
  local target_window
  local -a target_args

  if [[ -z "$TMUX" ]]; then
    echo "wf: -caw must be run inside a tmux session" >&2
    return 1
  fi

  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi

  if ! target_window="$(tmux display-message -p "${target_args[@]}" '#{session_id}:#{window_id}')"; then
    echo "wf: could not determine current window" >&2
    return 1
  fi

  if [[ -z "$target_window" || "$target_window" == ":" ]]; then
    echo "wf: could not determine current window" >&2
    return 1
  fi

  tmux kill-window -a -t "$target_window"
}

create_window() {
  local command="$1"
  local directory="$PWD"
  local count="${2:-1}"
  local index

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  if (( count == 0 )); then
    return 0
  fi

  if [[ "$command" == "-N" ]]; then
    if ! directory="$(tmux display-message -p '#{?@wf_directory,#{@wf_directory},#{session_path}}')"; then
      echo "wf: could not determine workspace directory" >&2
      return 1
    fi
  fi

  if [[ -z "$directory" || ! -d "$directory" ]]; then
    echo "wf: window directory does not exist: '$directory'" >&2
    return 1
  fi

  for (( index = 0; index < count; index++ )); do
    tmux new-window -c "$directory" || return 1
  done
}

close_current_window() {
  local window_count

  if [[ -z "$TMUX" ]]; then
    echo "wf: -cw must be run inside a tmux session" >&2
    return 1
  fi

  if ! window_count="$(tmux display-message -p '#{session_windows}')"; then
    echo "wf: could not determine window count" >&2
    return 1
  fi

  if [[ "$window_count" != <-> ]]; then
    echo "wf: could not determine window count" >&2
    return 1
  fi

  if (( window_count <= 1 )); then
    echo "wf: cannot close the last window in a session; use 'wf -d' to delete the workspace" >&2
    return 1
  fi

  tmux kill-window
}

reset_pane_layout() {
  local command="$1"
  local expected_count=4
  local pane_count window_id window_width info extra pane_ids main_pane main_width
  local -a target_args

  if [[ -z "$TMUX" ]]; then
    echo "wf: $command must be run inside a tmux session" >&2
    return 1
  fi

  [[ "$command" == "-rt" ]] && expected_count=3
  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi
  if ! info="$(tmux display-message -p "${target_args[@]}" '#{window_id} #{window_panes} #{window_width}')"; then
    echo "wf: could not determine current window" >&2
    return 1
  fi
  read -r window_id pane_count window_width extra <<< "$info"
  if [[ -z "$window_id" || "$pane_count" != <-> || "$window_width" != <-> || -n "$extra" ]]; then
    echo "wf: could not determine current window" >&2
    return 1
  fi
  if (( pane_count != expected_count )); then
    echo "wf: $command requires exactly $expected_count panes in the current window" >&2
    return 1
  fi

  if [[ "$command" == "-rq" ]]; then
    tmux select-layout -t "$window_id" tiled >/dev/null || return 1
  else
    pane_ids="$(tmux list-panes -t "$window_id" -F '#{pane_id}')" || return 1
    main_pane="${${(f)pane_ids}[1]}"
    [[ -n "$main_pane" ]] || return 1
    # Exclude the separator column, giving the left pane half of usable width.
    main_width=$(( (window_width - 1) / 2 ))
    tmux select-layout -t "$window_id" main-vertical >/dev/null || return 1
    tmux resize-pane -t "$main_pane" -x "$main_width" || return 1
  fi
  tmux set-option -w -t "$window_id" pane-base-index 1
}

is_valid_resize_value() {
  local value="$1"
  local digits

  if [[ "$value" =~ '^\+?(100|[0-9]{1,2})%$' ]]; then
    digits="${value%\%}"
    digits="${digits#+}"
    (( 10#$digits >= 1 ))
  else
    [[ "$value" =~ '^[+-]?(100|[0-9]{1,2})$' ]]
  fi
}

resize_current_pane() {
  local x="$1" y="$2"
  local pane_id pane_count pane_width pane_height extra info
  local value digits amount target dimension
  local -a target_args resize_args

  if ! is_valid_resize_value "$x" || ! is_valid_resize_value "$y"; then
    echo "wf: x and y must be integers from -100 to 100 or absolute percentages from 1% to 100%" >&2
    return 1
  fi

  if [[ -z "$TMUX" ]]; then
    echo "wf: -r must be run inside a tmux session" >&2
    return 1
  fi

  if [[ -n "$TMUX_PANE" ]]; then
    target_args=(-t "$TMUX_PANE")
  fi
  if ! info="$(tmux display-message -p "${target_args[@]}" '#{pane_id} #{window_panes} #{pane_width} #{pane_height}')"; then
    echo "wf: could not determine current pane dimensions" >&2
    return 1
  fi
  read -r pane_id pane_count pane_width pane_height extra <<< "$info"
  if [[ -z "$pane_id" || "$pane_count" != <-> || "$pane_width" != <-> || "$pane_height" != <-> || -n "$extra" ]]; then
    echo "wf: could not determine current pane dimensions" >&2
    return 1
  fi

  for dimension in x y; do
    if [[ "$dimension" == x ]]; then
      value="$x"
      target="$pane_width"
    else
      value="$y"
      target="$pane_height"
    fi

    if [[ "$value" == *% ]]; then
      digits="${value%\%}"
      digits="${digits#+}"
      resize_args+=("-$dimension" "$(( 10#$digits ))%")
    else
      digits="${value#[+-]}"
      amount=$(( 10#$digits ))
      [[ "$value" == -* ]] && amount=$(( -amount ))
      (( amount == 0 )) && continue
      target=$(( target + amount ))
      (( target < 1 )) && target=1
      resize_args+=("-$dimension" "$target")
    fi
  done

  (( ${#resize_args} == 0 )) && return 0
  if (( pane_count < 2 )); then
    echo "wf: -r requires at least 2 panes in the current window" >&2
    return 1
  fi

  tmux resize-pane -t "$pane_id" "${resize_args[@]}"
}

show_help() {
  cat <<'EOF'
wf - Workspace Flow

  wf                    List active workspaces.
  wf <name>             Create or enter a workspace.
  wf .                  Create a workspace named after the current directory.
  wf ~                  Create or enter a workspace in your home directory.
  wf -p <directory>     Create or enter a workspace at a path; reject name conflicts.
  wf -d [name]          Confirm and delete a workspace; defaults to current workspace.
  wf -git               Show Git branch and changes for child directories.
  wf --help, -h         Show this help.

Inside a workspace:
  wf -x                 Detach from the workspace.
  wf -n [0-5]           New window(s) here; defaults to 1.
  wf -N [0-5]           New window(s) at the workspace directory; defaults to 1.
  wf -s                 Split left/right in the current pane's directory.
  wf -S                 Split top/bottom in the current pane's directory.
  wf -r <x> <y>         Resize: cells -100..100, absolute sizes 1%..100%; 0 keeps size.
  wf -rq                Reset 4 panes to an equal 2x2 grid; keep panes and focus.
  wf -rt                Reset 3 panes to half-width left and stacked right; keep focus.
  wf -t, -tri           Left 1, top right 2, bottom right 3; requires 1 pane.
  wf -q, -quad          2x2 grid layout; requires 1 pane.
  wf -cs                Close this pane; protect the last pane.
  wf -cas               Close all other panes and their programs in this window.
  wf -cw                Close this window and its programs; protect the last window.
  wf -caw               Close all other windows and their programs in this workspace.
  wf -l, -label <name>  Add a custom label to the current window.
  wf -nl, -nolabel      Remove the custom label and resume automatic window naming.
EOF
}

main() {
  local command="$1"

  case "$command" in
    "")
      list_sessions
      ;;

    --help|-h)
      show_help
      ;;

    -p)
      if (( $# != 2 )); then
        echo "Usage: wf -p <directory>" >&2
        return 1
      fi

      create_or_enter_path_session "$2"
      ;;

    -git)
      if (( $# != 1 )); then
        echo "Usage: wf -git" >&2
        return 1
      fi

      list_repo_statuses
      ;;

    -rq|-rt)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      reset_pane_layout "$command"
      ;;

    -r)
      if (( $# != 3 )); then
        echo "Usage: wf -r <x> <y>" >&2
        return 1
      fi

      resize_current_pane "$2" "$3"
      ;;

    -l|-label)
      shift
      local window_label="$*"

      if [[ -z "$TMUX" ]]; then
        echo "wf: $command must be run inside a tmux session" >&2
        return 1
      fi

      if [[ -z "$window_label" ]]; then
        echo "Usage: wf $command <window_name>" >&2
        return 1
      fi

      tmux rename-window "$window_label"
      ;;

    -nl|-nolabel)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      if [[ -z "$TMUX" ]]; then
        echo "wf: $command must be run inside a tmux session" >&2
        return 1
      fi

      tmux set-window-option automatic-rename on
      ;;

    -d)
      local session_name="$2"

      if (( $# == 1 )); then
        delete_current_session
        return
      fi

      if (( $# != 2 )); then
        echo "Usage: wf -d [session_name]" >&2
        return 1
      fi

      if ! is_valid_session_name "$session_name"; then
        print_invalid_session_name "$session_name"
        return 1
      fi

      if ! session_exists "$session_name"; then
        echo "wf: session '$session_name' does not exist" >&2
        return 1
      fi

      delete_session "$session_name" "wf: delete '$session_name'? [y/N] "
      ;;

    -n|-N)
      if (( $# > 2 )); then
        echo "Usage: wf $command [n]" >&2
        return 1
      fi

      local count="${2-1}"
      if [[ ! "$count" =~ '^[0-5]$' ]]; then
        echo "wf: window count must be a whole number from 0 to 5" >&2
        return 1
      fi

      create_window "$command" "$count"
      ;;

    -cw)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      close_current_window
      ;;

    -q|-quad|-t|-tri)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      create_pane_layout "$command"
      ;;

    -cas|-caw)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      if [[ "$command" == "-caw" ]]; then
        close_other_windows
      else
        close_other_panes
      fi
      ;;

    -s|-S|-cs)
      if (( $# != 1 )); then
        echo "Usage: wf $command" >&2
        return 1
      fi

      if [[ "$command" == "-cs" ]]; then
        close_current_pane
      else
        split_current_pane "$command"
      fi
      ;;

    -x)
      if (( $# != 1 )); then
        echo "Usage: wf -x" >&2
        return 1
      fi

      detach_current_client
      ;;

    -*)
      echo "wf: unknown option '$command'" >&2
      echo "wf: run 'wf --help' for usage" >&2
      return 1
      ;;

    *)
      if (( $# != 1 )); then
        echo "Usage: wf <session_name>" >&2
        return 1
      fi

      if [[ "$command" == "." ]]; then
        create_session_from_current_directory
        return
      fi

      if [[ "$command" == "~" || "$command" == "$HOME" ]]; then
        create_or_enter_home_session
        return
      fi

      local session_name="$command"

      if ! is_valid_session_name "$session_name"; then
        print_invalid_session_name "$session_name"
        return 1
      fi

      if ! session_exists "$session_name"; then
        if ! create_default_session "$session_name"; then
          echo "wf: failed to create session '$session_name'" >&2
          return 1
        fi
      fi

      switch_or_attach "$session_name"
      ;;
  esac
}

main "$@"
